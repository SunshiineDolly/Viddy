{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viddy",
  "version": "0.26.9",
  "identifier": "app.puretube.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Viddy",
        "width": 1260,
        "height": 850,
        "minWidth": 820,
        "minHeight": 560,
        "useHttpsScheme": true,
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://*.ggpht.com https://*.googleusercontent.com; frame-src https://www.youtube.com; media-src https://*.googlevideo.com; connect-src ipc: https://ipc.localhost https://www.youtube.com; base-uri 'none'; object-src 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main",
            "player"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-minimize",
            "core:window:allow-close",
            "core:window:allow-toggle-maximize",
            "core:window:allow-start-dragging",
            "core:window:allow-is-maximized"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Viddy",
    "shortDescription": "YouTube without the noise.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/rename-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyODJFNDkyNjcyMjk4MkIKUldRcm1DSm5rdVNDd295Wk5reEdkQkNlMnJuRVYzK2lrdndOTmNmdUZCSDFkV0dybUpFRmN5S1MK",
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/SunshiineDolly/Viddy/releases/latest/download/latest.json"
      ]
    }
  }
}
